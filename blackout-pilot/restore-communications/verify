#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Stage 3: verify the recovery code decoded from the synthetic ROT13 note."""
import codecs
import hmac
from pathlib import Path


def expected_answer():
    try:
        plain = codecs.decode(
            Path("/challenge/recovery.rot13").read_text(encoding="utf-8"), "rot_13"
        )
        codes = [line.split("=", 1)[1].strip() for line in plain.splitlines()
                 if line.startswith("RESTORE_CODE=")]
        return codes[0] if len(codes) == 1 else None
    except (OSError, UnicodeError, ValueError):
        return None


def is_correct(answer):
    expected = expected_answer()
    return bool(expected) and hmac.compare_digest(answer.strip().casefold(), expected.casefold())


def main():
    try:
        answer = input("Restoration code: ")
    except EOFError:
        print("No answer provided.")
        return
    if is_correct(answer):
        print("Correct. Submit this unique pwn.college flag on the challenge page:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("Incorrect. Decode the recovery note and try again.")


if __name__ == "__main__":
    main()
