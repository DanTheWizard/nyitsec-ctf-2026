#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Verify the fictional code found by inspecting local website HTML source."""

import hashlib
import hmac
from pathlib import Path

EXPECTED_SHA256 = "1c2b8e76bc78579f3d02480a551e2c362dc3621d758c220ef7651109d5b3caab"


def is_correct(answer: str) -> bool:
    digest = hashlib.sha256(answer.strip().encode("utf-8")).hexdigest()
    return hmac.compare_digest(digest, EXPECTED_SHA256)


def main() -> None:
    print("NYITSec - Inspect the Source")
    try:
        answer = input("Enter the website review code: ")
    except EOFError:
        print("No answer entered.")
        return

    if is_correct(answer):
        print("Correct! Your unique pwn.college flag is:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("That code is not correct. Inspect the site's HTML source and try again.")


if __name__ == "__main__":
    main()
