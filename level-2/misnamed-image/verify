#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Check the exact phrase recovered from a misnamed PNG image."""

import hashlib
import hmac
from pathlib import Path

EXPECTED_SHA256 = "a9916f5b46629d38d438d96bbd1d932b5452eec16ad220bf04463c0ba4a9ecf0"


def is_correct(answer: str) -> bool:
    # The phrase inside the image is case-sensitive, including punctuation.
    guess = hashlib.sha256(answer.strip().encode("utf-8")).hexdigest()
    return hmac.compare_digest(guess, EXPECTED_SHA256)


def main() -> None:
    print("NYITSec - Hidden in Plain Sight")
    try:
        answer = input("Enter the phrase shown in the image: ")
    except EOFError:
        print("No answer entered.")
        return

    if is_correct(answer):
        print("Correct! Here is your unique pwn.college flag:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("Not quite. Examine the file's real format and try again.")


if __name__ == "__main__":
    main()
