#!/bin/sh
# NYITSec experimental workspace pilot. Invoked by pwn.college as root.
set -eu

# Only the pilot uses this setup; standard challenges remain untouched.
/usr/local/bin/python -I /challenge/.workspace.py

# Configure Bash in the disposable challenge container only, never ~/.bashrc.
bashrc=/etc/bashrc
marker='# NYITSec workspace pilot: open /nyitsec-ctf'
if [ ! -f "$bashrc" ]; then
    touch "$bashrc"
fi
if ! grep -Fq "$marker" "$bashrc"; then
    cat >> "$bashrc" <<'BASHRC'

# NYITSec workspace pilot: open /nyitsec-ctf
# Do not change directory for noninteractive commands or intentional navigation.
if [[ "$-" == *i* && "$PWD" == "/home/hacker" && -d /nyitsec-ctf ]]; then
    builtin cd /nyitsec-ctf
    printf '%s\n' '[NYITSec pilot] Temporary writable workspace. Save your work to ~/ before restarting this challenge.'
fi
BASHRC
fi
