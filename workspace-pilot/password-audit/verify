#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Evaluate a synthetic password-strength audit answer.

The student-specific /flag is revealed only when the provided password has
the expected lab digest. No real credentials or online services are involved.
"""

import hashlib
import hmac
from pathlib import Path

EXPECTED_SHA256 = "a5ebdb42521ba5a49a0021b4d3173f061c19a9efc484f4e81eb15db85c970213"


def is_correct(answer: str) -> bool:
    # Deliberately do not casefold: passwords are case-sensitive.
    # Keep spaces as-is because every byte matters to the hash.
    candidate_digest = hashlib.sha256(answer.encode("utf-8")).hexdigest()
    return hmac.compare_digest(candidate_digest, EXPECTED_SHA256)


def main() -> None:
    print("NYITSec - Weak Password Audit (synthetic lab)")
    try:
        answer = input("Enter the matching synthetic password: ")
    except EOFError:
        print("No answer submitted.")
        return

    if is_correct(answer):
        print("Correct! This password was predictable in our offline audit.")
        print("Your unique pwn.college flag is:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("Not a match. Review the candidate hashes and try again.")


if __name__ == "__main__":
    main()
