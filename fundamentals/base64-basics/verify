#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Check the decoded answer code, then reveal the student's pwn.college flag."""

import hashlib
import hmac
from pathlib import Path

# Compare a one-way digest, not a readable solution or a reusable flag.
EXPECTED_SHA256 = "33718928356f8a481e96ab89fb4aceb04eee567e5328fd39718e4237f830bfde"


def is_correct(answer: str) -> bool:
    candidate = answer.strip().casefold().encode("utf-8")
    digest = hashlib.sha256(candidate).hexdigest()
    return hmac.compare_digest(digest, EXPECTED_SHA256)


def main() -> None:
    print("NYITSec - Base64 Basics")
    try:
        answer = input("Enter the decoded answer code: ")
    except EOFError:
        print("No answer provided.")
        return

    if is_correct(answer):
        print("Correct! Here is your unique pwn.college flag:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("Not quite. Decode the provided file and try again.")


if __name__ == "__main__":
    main()
