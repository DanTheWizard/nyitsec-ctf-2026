#!/usr/bin/exec-suid -- /usr/local/bin/python -I
"""Verify the original message, then reveal the student's unique dojo flag."""

import hashlib
import hmac
from pathlib import Path

# SHA-256 of the case-folded final two-word message; never store a static flag.
EXPECTED_SHA256 = "4771bb276474974efd73222e69d3c2c990826a212e9b419761a70cc5c437d255"


def is_correct(answer: str) -> bool:
    digest = hashlib.sha256(answer.strip().casefold().encode("utf-8")).hexdigest()
    return hmac.compare_digest(digest, EXPECTED_SHA256)


def main() -> None:
    print("NYITSec - More Base64?")
    try:
        answer = input("Enter the final two-word message: ")
    except EOFError:
        print("No answer provided.")
        return

    if is_correct(answer):
        print("Correct! Your unique pwn.college flag is:")
        print(Path("/flag").read_text(encoding="utf-8").strip())
    else:
        print("Not quite. Follow the forwarded messages to their original source.")


if __name__ == "__main__":
    main()
