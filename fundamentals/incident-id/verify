#!/usr/bin/exec-suid -- /usr/local/bin/python -I

from pathlib import Path

LOG = Path("/challenge/events.log")

def matching_event_id():
    matches = []
    for line in LOG.read_text().splitlines():
        fields = dict(part.split("=", 1) for part in line.split() if "=" in part)
        if (fields.get("service") == "ssh"
                and fields.get("source") == "external"
                and fields.get("status") == "blocked"):
            matches.append(fields.get("event"))
    if len(matches) != 1:
        raise RuntimeError("Log must contain exactly one matching event")
    return matches[0]

print("NYITSec: SSH Log Investigation")
try:
    answer = input("Enter the matching event ID: ").strip()
except EOFError:
    print("No answer provided.")
else:
    if answer == matching_event_id():
        print("Correct! Your pwn.college flag is:")
        print(Path("/flag").read_text().strip())
    else:
        print("Not quite. Check the service, source, and status.")
